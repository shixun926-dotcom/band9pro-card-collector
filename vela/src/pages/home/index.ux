<template>
  <div class="page">
    <div class="topbar">
      <div class="brand">
        <text class="title">星卡集</text>
        <text class="eyebrow">DAILY COLLECTION</text>
      </div>
      <div class="counter">
        <text class="counter-text">{{summary.owned}}/{{summary.total}}</text>
      </div>
    </div>

    <scroll class="content" scroll-y="true">
      <div class="hero">
        <image class="hero-image" src="/common/cards/ssr01.png"></image>
        <div class="hero-copy">
          <text class="hero-kicker">今日卡池</text>
          <text class="hero-title">收集星象</text>
          <text class="hero-meta">{{summary.totalDraws}} 次抽取</text>
        </div>
      </div>

      <div class="section-head">
        <text class="section-title">今日机会</text>
        <text class="muted">{{availableCount}} 次可用</text>
      </div>

      <div class="task" if="{{status.login}}">
        <div class="task-no"><text class="task-number-text">01</text></div>
        <div class="task-copy">
          <text class="task-title">登录机会</text>
          <text class="task-meta">今日已获得一次抽卡</text>
        </div>
        <input
          class="draw-button"
          type="button"
          value="抽取"
          onclick="drawLogin"
        />
      </div>

      <div class="task done" if="{{!status.login}}">
        <div class="task-no"><text class="task-number-text">01</text></div>
        <div class="task-copy">
          <text class="task-title">登录机会</text>
          <text class="task-meta">今日机会已使用</text>
        </div>
      </div>

      <div class="task" if="{{status.exercise}}">
        <div class="task-no"><text class="task-number-text">02</text></div>
        <div class="task-copy">
          <text class="task-title">运动机会</text>
          <text class="task-meta">目标已达成</text>
        </div>
        <input
          class="draw-button"
          type="button"
          value="抽取"
          onclick="drawExercise"
        />
      </div>

      <div class="task done" if="{{!status.exercise}}">
        <div class="task-no"><text class="task-number-text">02</text></div>
        <div class="task-copy">
          <text class="task-title">运动机会</text>
          <text class="task-meta">{{status.exerciseValue}}/{{status.exerciseTarget}} 步</text>
          <div class="progress-track">
            <div class="progress-fill" style="width: {{exercisePercent}}%"></div>
          </div>
        </div>
      </div>
    </scroll>

    <div class="nav">
      <div class="nav-active"><text class="nav-text-active">抽卡</text></div>
      <div class="nav-item" onclick="openCollection">
        <text class="nav-text">图鉴</text>
      </div>
    </div>

    <div class="reveal-mask" if="{{reveal}}">
      <div class="reveal-panel">
        <text class="reveal-kicker">{{reveal.rarityName}}</text>
        <image class="reveal-image" src="{{reveal.uiAsset}}"></image>
        <text class="reveal-name">{{reveal.name}}</text>
        <text class="reveal-flavor">{{reveal.flavor}}</text>
        <text class="new-tag" if="{{isNew}}">NEW</text>
        <text class="new-tag" if="{{!isNew}}">已拥有 x{{reveal.count}}</text>
        <input
          class="confirm-button"
          type="button"
          value="收下"
          onclick="closeReveal"
        />
      </div>
    </div>
  </div>
</template>

<script>
import router from "@system.router"
import storage from "@system.storage"
import health from "@service.health"
import {
  claimDailyLogin,
  createInitialState,
  drawCard,
  getCardDetail,
  getCollectionSummary,
  getDailyStatus,
  recordExercise
} from "../../core/game.js"
import {
  getLocalDayKey,
  readState,
  writeState
} from "../../core/runtime.js"

export default {
  private: {
    state: null,
    summary: {
      owned: 0,
      total: 24,
      totalDraws: 0
    },
    status: {
      login: false,
      exercise: false,
      exerciseValue: 0,
      exerciseTarget: 8000,
      exerciseProgress: 0
    },
    reveal: null,
    isNew: false
  },

  data: {
    availableCount: 0,
    exercisePercent: 0,
    busy: false
  },

  onInit() {
    this.loadState()
  },

  onShow() {
    if (this.state) {
      this.refreshView(this.state)
    }
  },

  async loadState() {
    const stored = await readState(storage)
    const today = getLocalDayKey()
    const result = claimDailyLogin(
      stored || createInitialState(),
      today
    )

    this.state = result.state
    this.refreshView(result.state)
    await writeState(storage, result.state)
    this.loadSteps()
  },

  loadSteps() {
    const self = this

    health.getTodaySteps({
      success(data) {
        self.applyExercise(data.steps)
      },
      fail() {}
    })
  },

  async applyExercise(steps) {
    if (!this.state || !Number.isFinite(Number(steps))) {
      return
    }

    const result = recordExercise(
      this.state,
      getLocalDayKey(),
      Number(steps)
    )

    this.state = result.state
    this.refreshView(result.state)
    await writeState(storage, result.state)
  },

  refreshView(state) {
    this.summary = getCollectionSummary(state)
    this.status = getDailyStatus(state)
    this.availableCount =
      Number(this.status.login) + Number(this.status.exercise)
    this.exercisePercent = Math.round(
      this.status.exerciseProgress * 100
    )
  },

  async draw(source) {
    if (this.busy || !this.state) {
      return
    }

    this.busy = true

    try {
      const result = drawCard(this.state, source)
      const detail = getCardDetail(result.state, result.card.id)

      this.state = result.state
      this.reveal = {
        ...detail,
        uiAsset: `/common/cards/${detail.id}.png`
      }
      this.isNew = result.isNew
      this.refreshView(result.state)
      await writeState(storage, result.state)
    } catch (error) {
      this.refreshView(this.state)
    }

    this.busy = false
  },

  drawLogin() {
    this.draw("login")
  },

  drawExercise() {
    this.draw("exercise")
  },

  closeReveal() {
    this.reveal = null
    this.isNew = false
  },

  openCollection() {
    router.push({
      uri: "/pages/collection"
    })
  }
}
</script>

